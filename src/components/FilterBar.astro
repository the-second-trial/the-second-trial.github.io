---
const { tags = [] } = Astro.props;
const chips = ['all', ...tags];
---

<div class="filterbar" role="group" aria-label="Filter by topic">
  {
    chips.map((tag) => (
      <button
        class="chip"
        type="button"
        data-filter={tag}
        aria-pressed={tag === 'all' ? 'true' : 'false'}
      >
        {tag === 'all' ? '--all' : `--${tag}`}
      </button>
    ))
  }
</div>

<style>
  .filterbar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .chip {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0;
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    transition: color 0.16s ease, border-color 0.16s ease,
      background 0.16s ease;
  }
  .chip:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .chip[aria-pressed='true'] {
    color: var(--bg);
    background: var(--accent);
    border-color: var(--accent);
    text-shadow: none;
  }
</style>
