---
const { item } = Astro.props;
const { title, description, href, tags = [], date } = item;

const formattedDate = date
  ? new Date(date).toLocaleDateString('en-CA', { timeZone: 'UTC' }) // YYYY-MM-DD
  : null;

const searchText = `${title} ${description} ${tags.join(' ')}`.toLowerCase();
---

<a
  class="card"
  href={href}
  data-tags={tags.join(' ')}
  data-search={searchText}
>
  <div class="card-head">
    <span class="marker" aria-hidden="true">&gt;</span>
    <h3 class="card-title">{title}</h3>
    {formattedDate && <time class="date">[{formattedDate}]</time>}
  </div>

  <p class="card-desc">{description}</p>

  <div class="card-foot">
    <ul class="tags">
      {tags.map((t) => <li>--{t}</li>)}
    </ul>
    <span class="go" aria-hidden="true">↵</span>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding: 1.1rem 1.2rem;
    height: 100%;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text);
    transition: border-color 0.18s ease, background 0.18s ease,
      box-shadow 0.18s ease;
  }
  .card:hover {
    background: var(--surface-hover);
    border-color: var(--accent);
    box-shadow: inset 0 0 0 1px var(--accent-glow), 0 0 20px -6px var(--accent-glow);
    text-decoration: none;
  }

  .card-head {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .marker {
    color: var(--accent);
    opacity: 0.5;
    line-height: 1.05;
    transition: opacity 0.18s ease;
  }
  .card:hover .marker {
    opacity: 1;
  }

  .card-title {
    font-size: 1.05rem;
    line-height: 1.05;
    margin: 0;
    color: var(--text);
    flex: 1;
  }
  .card:hover .card-title {
    color: var(--accent);
  }

  .date {
    font-size: 0.72rem;
    color: var(--text-faint);
  }

  .card-desc {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .card-foot {
    margin-top: auto;
    padding-top: 0.4rem;
    padding-left: 1.1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.72rem;
    color: var(--text-faint);
  }

  .go {
    color: var(--accent);
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.18s ease, transform 0.18s ease;
  }
  .card:hover .go {
    opacity: 1;
    transform: translateX(0);
  }
</style>
