---
const { item } = Astro.props;
const { title, description, href, tags = [], date } = item;

const formattedDate = date
  ? new Date(date).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'short',
    })
  : null;

const searchText = `${title} ${description} ${tags.join(' ')}`.toLowerCase();
---

<a
  class="card"
  href={href}
  data-tags={tags.join(' ')}
  data-search={searchText}
>
  {
    formattedDate && (
      <div class="card-head">
        <time class="date">{formattedDate}</time>
      </div>
    )
  }

  <h3 class="card-title">{title}</h3>
  <p class="card-desc">{description}</p>

  <div class="card-foot">
    <ul class="tags">
      {tags.map((t) => <li>#{t}</li>)}
    </ul>
    <span class="go" aria-hidden="true">→</span>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.4rem;
    height: 100%;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    transition: transform 0.22s ease, border-color 0.22s ease,
      background 0.22s ease, box-shadow 0.22s ease;
  }
  .card:hover {
    transform: translateY(-4px);
    background: var(--surface-hover);
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent-glow), 0 18px 40px -20px var(--accent-glow);
  }

  .card-head {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem;
  }

  .date {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-faint);
  }

  .card-title {
    font-size: 1.25rem;
    margin: 0;
  }
  .card:hover .card-title {
    color: #fff;
  }

  .card-desc {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .card-foot {
    margin-top: auto;
    padding-top: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-faint);
  }

  .go {
    color: var(--accent);
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.22s ease, transform 0.22s ease;
  }
  .card:hover .go {
    opacity: 1;
    transform: translateX(0);
  }
</style>
