---
const tagline =
  'A log of experiments and essays on science, data, and the things worth a second look.';
---

<header class="hero" id="top">
  <span class="hero-sentinel" aria-hidden="true"></span>
  <div class="scanlines" aria-hidden="true"></div>

  <div class="wrap hero-inner">
    <div class="term">
      <p class="line"><span class="prompt">the-2nd-trial:~$</span> whoami</p>
      <h1 class="title" id="glitch-title" aria-label="the_2nd_trial">the_2nd_trial</h1>
      <p class="line out">{tagline}</p>
      <p class="line"><span class="prompt">the-2nd-trial:~$</span> <span
          class="cmd"
          id="typed"
          data-cmd="uname --operator"></span><span
          class="caret"
          id="caret"
          aria-hidden="true"></span></p>
      <p class="line answer" id="answer" hidden>andrea tino</p>
    </div>

    <a class="scroll-cue" href="#work" aria-label="Jump to the work">
      <span class="arrow" aria-hidden="true">↓</span>
      <span>cat ./work/*</span>
    </a>
  </div>
</header>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(4.5rem, 14vh, 8rem);
    border-bottom: 1px solid var(--border);
    background:
      radial-gradient(140% 90% at 50% 0%, var(--bg-soft) 0%, var(--bg) 65%);
  }

  /* faint CRT scanlines + soft phosphor glow */
  .scanlines {
    position: absolute;
    inset: 0;
    background:
      repeating-linear-gradient(
        to bottom,
        rgba(51, 255, 102, 0.03) 0px,
        rgba(51, 255, 102, 0.03) 1px,
        transparent 1px,
        transparent 4px
      );
    -webkit-mask-image: radial-gradient(
      120% 100% at 50% 30%,
      #000 0%,
      transparent 85%
    );
    mask-image: radial-gradient(120% 100% at 50% 30%, #000 0%, transparent 85%);
    pointer-events: none;
    opacity: 0.5;
  }

  .hero-inner {
    position: relative;
  }

  .hero-sentinel {
    position: absolute;
    bottom: 80px;
    left: 0;
    width: 1px;
    height: 1px;
  }

  .term {
    max-width: 70ch;
  }

  .line {
    margin: 0 0 0.4rem;
    font-size: clamp(0.95rem, 2.2vw, 1.15rem);
    color: var(--text);
    white-space: pre-wrap;
  }
  .line.out {
    color: var(--text-muted);
    margin: 1.1rem 0;
    max-width: 60ch;
  }

  .prompt {
    color: var(--accent);
  }
  .cmd {
    color: var(--text);
  }

  /* block caret that blinks while/after typing */
  .caret {
    display: inline-block;
    width: 0.6ch;
    height: 1.1em;
    margin-left: 0.1ch;
    transform: translateY(0.18em);
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent-glow);
    animation: caret-blink 1.1s step-end infinite;
  }
  @keyframes caret-blink {
    0%,
    50% {
      opacity: 1;
    }
    50.01%,
    100% {
      opacity: 0;
    }
  }

  .answer {
    color: var(--text);
    margin: -0.2rem 0 0;
  }
  .answer[hidden] {
    display: none;
  }

  .title {
    font-size: clamp(2.4rem, 8vw, 4.6rem);
    margin: 0.6rem 0 0.4rem;
    color: var(--accent);
    letter-spacing: 0;
    text-shadow: 0 0 18px var(--accent-glow);
  }

  /* per-character glitch state */
  .title span {
    display: inline-block;
    transition: color 0.08s ease, text-shadow 0.08s ease;
  }
  .title span.glitched {
    color: var(--bg);
    background: var(--accent);
    text-shadow: none;
  }

  .scroll-cue {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 2.5rem;
    padding: 0.55rem 1rem;
    border: 1px solid var(--border-strong);
    color: var(--text);
    font-size: 0.85rem;
    transition: color 0.18s ease, border-color 0.18s ease,
      background 0.18s ease;
  }
  .scroll-cue::before {
    content: '>';
    color: var(--accent);
  }
  .scroll-cue:hover {
    border-color: var(--accent);
    background: var(--surface-hover);
    color: var(--accent);
    text-decoration: none;
  }
  .arrow {
    animation: bob 1.8s ease-in-out infinite;
  }

  @keyframes bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(3px);
    }
  }
</style>

<script>
  const typed = document.getElementById('typed');
  const caret = document.getElementById('caret');
  const answer = document.getElementById('answer');
  const cmd = typed?.dataset.cmd ?? '';

  const reduceMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)'
  ).matches;

  if (typed && answer) {
    if (reduceMotion) {
      // no animation: show final state immediately
      typed.textContent = cmd;
      answer.hidden = false;
    } else {
      let i = 0;

      const typeNext = () => {
        if (i <= cmd.length) {
          typed.textContent = cmd.slice(0, i);
          i++;
          // slight human-like jitter in keystroke timing
          window.setTimeout(typeNext, 55 + Math.random() * 70);
        } else {
          // command "submitted": brief pause, then show the answer
          window.setTimeout(() => {
            answer.hidden = false;
          }, 450);
        }
      };

      // small initial delay so the page settles first
      window.setTimeout(typeNext, 650);
    }
  }

  /* ---- glitch the big title at non-uniform intervals ---- */
  const title = document.getElementById('glitch-title');

  if (title && !reduceMotion) {
    const original = title.textContent ?? '';

    // map a character to its "glitched" form; null = not glitchable
    const glitchOf = (ch: string): string | null => {
      if (ch === '_') return null; // underscores excluded
      if (ch === 'i') return '1';
      if (ch === '2') return 'Z';
      if (/[a-z]/.test(ch)) return ch.toUpperCase();
      return null;
    };

    // build per-character spans, remembering which are glitchable
    title.textContent = '';
    const cells: { el: HTMLSpanElement; base: string; glitch: string }[] = [];

    for (const ch of original) {
      const span = document.createElement('span');
      span.textContent = ch;
      title.appendChild(span);
      const g = glitchOf(ch);
      if (g !== null) cells.push({ el: span, base: ch, glitch: g });
    }

    const pick = <T,>(arr: T[], n: number): T[] => {
      const pool = arr.slice();
      const out: T[] = [];
      for (let k = 0; k < n && pool.length; k++) {
        out.push(pool.splice(Math.floor(Math.random() * pool.length), 1)[0]);
      }
      return out;
    };

    const tick = () => {
      const count = 1 + Math.floor(Math.random() * 2); // 1 or 2 letters
      const chosen = pick(cells, count);

      chosen.forEach((c) => {
        c.el.textContent = c.glitch;
        c.el.classList.add('glitched');
      });

      // hold the glitch briefly, then revert
      const hold = 140 + Math.random() * 260;
      window.setTimeout(() => {
        chosen.forEach((c) => {
          c.el.textContent = c.base;
          c.el.classList.remove('glitched');
        });
      }, hold);

      // non-uniform gap before the next glitch
      const gap = 900 + Math.random() * 1600;
      window.setTimeout(tick, gap);
    };

    window.setTimeout(tick, 1400);
  }
</script>
