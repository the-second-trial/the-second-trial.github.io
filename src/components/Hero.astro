---
const tagline =
  'A log of experiments and essays on science, data, and the things worth a second look.';
---

<header class="hero" id="top">
  <span class="hero-sentinel" aria-hidden="true"></span>
  <div class="scanlines" aria-hidden="true"></div>

  <div class="wrap hero-inner">
    <div class="term">
      <p class="line"><span class="prompt">the-2nd-trial:~$</span> whoami</p>
      <h1 class="title">the_2nd_trial</h1>
      <p class="line out">{tagline}</p>
      <p class="line">
        <span class="prompt">the-2nd-trial:~$</span>
        <span class="cmd cursor">ls ./work</span>
      </p>
    </div>

    <a class="scroll-cue" href="#work" aria-label="Jump to the work">
      <span class="arrow" aria-hidden="true">↓</span>
      <span>cat ./work/*</span>
    </a>
  </div>
</header>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(4.5rem, 14vh, 8rem);
    border-bottom: 1px solid var(--border);
    background:
      radial-gradient(140% 90% at 50% 0%, var(--bg-soft) 0%, var(--bg) 65%);
  }

  /* faint CRT scanlines + soft phosphor glow */
  .scanlines {
    position: absolute;
    inset: 0;
    background:
      repeating-linear-gradient(
        to bottom,
        rgba(51, 255, 102, 0.03) 0px,
        rgba(51, 255, 102, 0.03) 1px,
        transparent 1px,
        transparent 4px
      );
    -webkit-mask-image: radial-gradient(
      120% 100% at 50% 30%,
      #000 0%,
      transparent 85%
    );
    mask-image: radial-gradient(120% 100% at 50% 30%, #000 0%, transparent 85%);
    pointer-events: none;
    opacity: 0.5;
  }

  .hero-inner {
    position: relative;
  }

  .hero-sentinel {
    position: absolute;
    bottom: 80px;
    left: 0;
    width: 1px;
    height: 1px;
  }

  .term {
    max-width: 70ch;
  }

  .line {
    margin: 0 0 0.4rem;
    font-size: clamp(0.95rem, 2.2vw, 1.15rem);
    color: var(--text);
    white-space: pre-wrap;
  }
  .line.out {
    color: var(--text-muted);
    margin: 1.1rem 0;
    max-width: 60ch;
  }

  .prompt {
    color: var(--accent);
  }
  .cmd {
    color: var(--text);
  }

  .title {
    font-size: clamp(2.4rem, 8vw, 4.6rem);
    margin: 0.6rem 0 0.4rem;
    color: var(--accent);
    letter-spacing: 0;
    text-shadow: 0 0 18px var(--accent-glow);
  }

  .scroll-cue {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 2.5rem;
    padding: 0.55rem 1rem;
    border: 1px solid var(--border-strong);
    color: var(--text);
    font-size: 0.85rem;
    transition: color 0.18s ease, border-color 0.18s ease,
      background 0.18s ease;
  }
  .scroll-cue::before {
    content: '>';
    color: var(--accent);
  }
  .scroll-cue:hover {
    border-color: var(--accent);
    background: var(--surface-hover);
    color: var(--accent);
    text-decoration: none;
  }
  .arrow {
    animation: bob 1.8s ease-in-out infinite;
  }

  @keyframes bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(3px);
    }
  }
</style>
