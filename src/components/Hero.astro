---
const tagline =
  'Articles and projects on science, data, and the things worth a second look.';
---

<header class="hero" id="top">
  <span class="hero-sentinel" aria-hidden="true"></span>
  <div class="stars" aria-hidden="true"></div>
  <div class="glow" aria-hidden="true"></div>

  <div class="wrap hero-inner">
    <p class="eyebrow">// experiments &amp; essays</p>
    <h1 class="title">The 2nd Trial</h1>
    <p class="tagline">{tagline}</p>
    <a class="scroll-cue" href="#work" aria-label="Jump to the work">
      <span>Explore the work</span>
      <span class="arrow" aria-hidden="true">↓</span>
    </a>
  </div>
</header>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(5rem, 16vh, 9rem);
    border-bottom: 1px solid var(--border);
    background: radial-gradient(
        120% 80% at 50% -10%,
        var(--bg-soft) 0%,
        var(--bg) 60%
      );
  }

  .glow {
    position: absolute;
    top: -30%;
    left: 50%;
    transform: translateX(-50%);
    width: min(900px, 90vw);
    height: 600px;
    background: radial-gradient(
        45% 45% at 50% 50%,
        var(--accent-glow) 0%,
        transparent 70%
      ),
      radial-gradient(
        40% 40% at 65% 40%,
        rgba(96, 165, 250, 0.18) 0%,
        transparent 70%
      );
    filter: blur(8px);
    pointer-events: none;
  }

  .stars {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(
        1px 1px at 20% 30%,
        rgba(255, 255, 255, 0.6) 50%,
        transparent
      ),
      radial-gradient(1px 1px at 80% 20%, rgba(255, 255, 255, 0.5) 50%, transparent),
      radial-gradient(1px 1px at 60% 70%, rgba(255, 255, 255, 0.4) 50%, transparent),
      radial-gradient(1px 1px at 35% 80%, rgba(255, 255, 255, 0.5) 50%, transparent),
      radial-gradient(1.5px 1.5px at 90% 60%, rgba(255, 255, 255, 0.5) 50%, transparent),
      radial-gradient(1px 1px at 10% 60%, rgba(255, 255, 255, 0.4) 50%, transparent);
    opacity: 0.7;
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    text-align: center;
  }

  /* sentinel sits near the bottom of the hero; when it scrolls out of
     view the sticky header is revealed */
  .hero-sentinel {
    position: absolute;
    bottom: 80px;
    left: 0;
    width: 1px;
    height: 1px;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 1rem;
  }

  .title {
    font-size: clamp(2.75rem, 9vw, 5.5rem);
    margin: 0;
    background: linear-gradient(180deg, #fff 0%, var(--text-muted) 130%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .tagline {
    max-width: 46ch;
    margin: 1.25rem auto 0;
    font-size: clamp(1rem, 2.5vw, 1.2rem);
    color: var(--text-muted);
  }

  .scroll-cue {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 2.5rem;
    padding: 0.6rem 1.1rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    color: var(--text);
    font-size: 0.9rem;
    transition: border-color 0.2s ease, background 0.2s ease, transform 0.2s ease;
  }
  .scroll-cue:hover {
    border-color: var(--accent);
    background: var(--surface);
    transform: translateY(-2px);
  }
  .arrow {
    animation: bob 1.8s ease-in-out infinite;
  }

  @keyframes bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(3px);
    }
  }
</style>
