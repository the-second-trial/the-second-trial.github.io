---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import StickyHeader from '../components/StickyHeader.astro';
import FilterBar from '../components/FilterBar.astro';
import Card from '../components/Card.astro';
import { items, allTags } from '../data/items.js';

// newest first
const sorted = [...items].sort((a, b) =>
  (b.date ?? '').localeCompare(a.date ?? '')
);
---

<Layout title="The 2nd Trial">
  <StickyHeader title="The 2nd Trial" />
  <Hero />

  <section id="work" class="work">
    <div class="wrap">
      <div class="section-head">
        <h2>The Work</h2>
        <p class="count">
          <span id="count">{sorted.length}</span> of {sorted.length}
        </p>
      </div>

      <div class="controls" id="controls">
        <div class="search">
          <span class="search-icon" aria-hidden="true">⌕</span>
          <input
            type="search"
            id="search"
            placeholder="Search the work…"
            aria-label="Search the work"
            autocomplete="off"
          />
        </div>
        <FilterBar tags={allTags} />
      </div>

      <div class="grid" id="grid">
        {sorted.map((item) => <Card item={item} />)}
      </div>

      <p class="empty" id="empty" hidden>Nothing here for that search yet.</p>

      <div class="loadmore-wrap">
        <button class="loadmore" id="loadmore" type="button" hidden>
          Load more
        </button>
      </div>
    </div>
  </section>

  <footer class="footer">
    <div class="footer-paper" aria-hidden="true"></div>
    <div class="wrap">
      <p>The 2nd Trial &middot; a second look at science.</p>
    </div>
  </footer>
</Layout>

<style>
  .work {
    padding-block: clamp(3rem, 8vh, 5rem);
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .section-head h2 {
    font-size: clamp(1.5rem, 4vw, 2rem);
    margin: 0;
  }
  .count {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-faint);
    margin: 0;
  }

  /* sticky controls bar: search + filter chips */
  .controls {
    position: sticky;
    top: var(--sticky-top, 0px);
    z-index: 40;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    margin-bottom: 2rem;
    padding-block: 0.9rem;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition: top 0.3s ease;
  }

  .search {
    position: relative;
    display: flex;
    align-items: center;
  }
  .search-icon {
    position: absolute;
    left: 0.9rem;
    color: var(--text-faint);
    font-size: 1.1rem;
    pointer-events: none;
  }
  .search input {
    width: 100%;
    padding: 0.7rem 1rem 0.7rem 2.4rem;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    outline: none;
    transition: border-color 0.18s ease, box-shadow 0.18s ease,
      background 0.18s ease;
  }
  .search input::placeholder {
    color: var(--text-faint);
  }
  .search input:focus {
    border-color: var(--accent);
    background: var(--surface-hover);
    box-shadow: 0 0 0 3px var(--accent-glow);
  }
  /* hide native search clear button styling inconsistencies */
  .search input::-webkit-search-cancel-button {
    -webkit-appearance: none;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .empty {
    margin-top: 2rem;
    text-align: center;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .loadmore-wrap {
    display: flex;
    justify-content: center;
    margin-top: 2.5rem;
  }
  .loadmore {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    padding: 0.7rem 1.6rem;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: color 0.18s ease, border-color 0.18s ease,
      background 0.18s ease, box-shadow 0.18s ease, transform 0.18s ease;
  }
  .loadmore:hover {
    color: #fff;
    border-color: var(--accent);
    background: var(--surface-hover);
    box-shadow: 0 0 18px -4px var(--accent-glow);
    transform: translateY(-2px);
  }
  .loadmore[hidden] {
    display: none;
  }

  /* scroll-in animation */
  .grid :global(.card) {
    opacity: 0;
    transform: translateY(12px);
    animation: rise 0.5s ease forwards;
  }
  @keyframes rise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .footer {
    position: relative;
    overflow: hidden;
    border-top: 1px solid var(--border);
    padding-block: 4rem;
    background: radial-gradient(
      120% 120% at 50% 120%,
      var(--bg-soft) 0%,
      var(--bg) 60%
    );
  }
  .footer .wrap {
    position: relative;
  }
  .footer p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .footer-paper {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(
        to right,
        color-mix(in srgb, var(--accent) 22%, transparent) 1px,
        transparent 1px
      ),
      linear-gradient(
        to bottom,
        color-mix(in srgb, var(--accent) 22%, transparent) 1px,
        transparent 1px
      ),
      linear-gradient(to right, rgba(255, 255, 255, 0.06) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.06) 1px, transparent 1px);
    background-size:
      120px 120px,
      120px 120px,
      24px 24px,
      24px 24px;
    background-position: center center;
    -webkit-mask-image: radial-gradient(
      120% 100% at 50% 100%,
      #000 0%,
      transparent 80%
    );
    mask-image: radial-gradient(
      120% 100% at 50% 100%,
      #000 0%,
      transparent 80%
    );
    pointer-events: none;
  }
</style>

<script>
  const PAGE_SIZE = 9;

  const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
  const cards = Array.from(
    document.querySelectorAll<HTMLElement>('#grid .card')
  );
  const searchInput = document.getElementById('search') as HTMLInputElement | null;
  const countEl = document.getElementById('count');
  const emptyEl = document.getElementById('empty');
  const loadMoreBtn = document.getElementById('loadmore') as HTMLButtonElement | null;

  let activeTag = 'all';
  let query = '';
  let limit = PAGE_SIZE;

  function matches(card: HTMLElement): boolean {
    const tags = (card.dataset.tags ?? '').split(' ');
    const tagOk = activeTag === 'all' || tags.includes(activeTag);
    const text = card.dataset.search ?? '';
    const searchOk = query === '' || text.includes(query);
    return tagOk && searchOk;
  }

  function render() {
    let matched = 0;
    let shown = 0;

    cards.forEach((card) => {
      if (!matches(card)) {
        card.style.display = 'none';
        return;
      }
      matched++;
      if (shown < limit) {
        const wasHidden = card.style.display === 'none';
        card.style.display = '';
        // only animate newly revealed cards
        if (wasHidden) {
          card.style.animation = 'none';
          // force reflow then restart
          void card.offsetWidth;
          card.style.animation = '';
        }
        shown++;
      } else {
        card.style.display = 'none';
      }
    });

    if (countEl) countEl.textContent = String(matched);
    if (emptyEl) emptyEl.hidden = matched !== 0;
    if (loadMoreBtn) loadMoreBtn.hidden = shown >= matched;
  }

  // --- filter chips ---
  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      chips.forEach((c) => c.setAttribute('aria-pressed', 'false'));
      chip.setAttribute('aria-pressed', 'true');
      activeTag = chip.dataset.filter ?? 'all';
      limit = PAGE_SIZE;
      render();
    });
  });

  // --- search (debounced) ---
  let debounce: number | undefined;
  searchInput?.addEventListener('input', () => {
    window.clearTimeout(debounce);
    debounce = window.setTimeout(() => {
      query = searchInput.value.trim().toLowerCase();
      limit = PAGE_SIZE;
      render();
    }, 120);
  });

  // --- load more ---
  loadMoreBtn?.addEventListener('click', () => {
    limit += PAGE_SIZE;
    render();
  });

  // initial staggered animation delays (first page only)
  cards.forEach((card, i) => {
    card.style.animationDelay = `${Math.min(i * 60, 480)}ms`;
  });

  render();

  // --- compact sticky header reveal + offset for sticky controls ---
  const sentinel = document.querySelector('.hero-sentinel');
  const stickyHeader = document.getElementById('sticky-header');
  const root = document.documentElement;

  function setStickyTop(visible: boolean) {
    const h = stickyHeader?.offsetHeight ?? 0;
    root.style.setProperty('--sticky-top', visible ? `${h}px` : '0px');
  }

  if (sentinel && stickyHeader) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        const visible = !entry.isIntersecting;
        stickyHeader.dataset.state = visible ? 'visible' : 'hidden';
        setStickyTop(visible);
      },
      { rootMargin: '0px', threshold: 0 }
    );
    observer.observe(sentinel);
  }
</script>
