---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import StickyHeader from '../components/StickyHeader.astro';
import FilterBar from '../components/FilterBar.astro';
import Card from '../components/Card.astro';

const entries = await getCollection('work');

// map collection entries to the shape Card expects, newest first
const sorted = entries
  .map((entry) => ({
    title: entry.data.title,
    description: entry.data.description,
    href: `/work/${entry.id}/`,
    tags: entry.data.tags,
    date: entry.data.date,
  }))
  .sort((a, b) => b.date.getTime() - a.date.getTime());

const allTags = [...new Set(sorted.flatMap((i) => i.tags))].sort();
---

<Layout title="the-2nd-trial">
  <StickyHeader title="the-2nd-trial" />
  <Hero />

  <section id="work" class="work">
    <div class="wrap">
      <div class="section-head">
        <h2><span class="sh-prompt">$</span> ls ./work</h2>
        <p class="count">
          <span id="count">{sorted.length}</span>/{sorted.length} entries
        </p>
      </div>

      <div class="controls" id="controls">
        <div class="search">
          <span class="search-icon" aria-hidden="true">grep&gt;</span>
          <input
            type="search"
            id="search"
            placeholder="filter entries…"
            aria-label="Search the work"
            autocomplete="off"
          />
        </div>
        <FilterBar tags={allTags} />
      </div>

      <div class="grid" id="grid">
        {sorted.map((item) => <Card item={item} />)}
      </div>

      <p class="empty" id="empty" hidden>
        # no matches. try a different filter.
      </p>

      <div class="loadmore-wrap">
        <button class="loadmore" id="loadmore" type="button" hidden>
          load --more
        </button>
      </div>
    </div>
  </section>

  <section id="about" class="about">
    <div class="wrap">
      <div class="section-head">
        <h2><span class="sh-prompt">$</span> cat ./about.md</h2>
      </div>

      <div class="about-body">
        <p>
          <span class="about-mark"># </span>The 2nd Trial is a personal log of
          experiments and essays on science, data, and the things worth a
          second look.
        </p>
        <p>
          Each entry is a small attempt to understand something properly —
          rebuilt from scratch, questioned, and written down. Some are
          interactive, some are just prose. All of them are second tries at
          getting it right.
        </p>
        <p>
          Built and maintained by <span class="about-name">andrea tino</span>.
        </p>
      </div>
    </div>
  </section>

  <footer class="footer">
    <div class="footer-scanlines" aria-hidden="true"></div>
    <div class="wrap">
      <p>
        <span class="f-prompt">the-2nd-trial:~$</span> echo "a second look at
        science"
      </p>
    </div>
  </footer>
</Layout>

<style>
  .work {
    padding-block: clamp(3rem, 8vh, 5rem);
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .section-head h2 {
    font-size: clamp(1.2rem, 3.5vw, 1.7rem);
    margin: 0;
    color: var(--text);
  }
  .sh-prompt {
    color: var(--accent);
  }
  .count {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-faint);
    margin: 0;
  }

  /* sticky controls bar: search + filter chips */
  .controls {
    position: sticky;
    top: var(--sticky-top, 0px);
    z-index: 40;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    margin-bottom: 2rem;
    padding-block: 0.8rem;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
    transition: top 0.3s ease;
  }

  .search {
    position: relative;
    display: flex;
    align-items: center;
  }
  .search-icon {
    position: absolute;
    left: 0.7rem;
    color: var(--accent);
    font-size: 0.85rem;
    pointer-events: none;
  }
  .search input {
    width: 100%;
    padding: 0.6rem 0.8rem 0.6rem 3.4rem;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 0;
    outline: none;
    transition: border-color 0.16s ease, box-shadow 0.16s ease,
      background 0.16s ease;
  }
  .search input::placeholder {
    color: var(--text-faint);
  }
  .search input:focus {
    border-color: var(--accent);
    background: var(--surface-hover);
    box-shadow: inset 0 0 0 1px var(--accent-glow);
  }
  .search input::-webkit-search-cancel-button {
    -webkit-appearance: none;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 1.25rem;
  }

  .empty {
    margin-top: 2rem;
    text-align: left;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .loadmore-wrap {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
  }
  .loadmore {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    letter-spacing: 0;
    padding: 0.55rem 1.4rem;
    color: var(--text);
    background: transparent;
    border: 1px solid var(--border-strong);
    border-radius: 0;
    cursor: pointer;
    transition: color 0.16s ease, border-color 0.16s ease,
      background 0.16s ease;
  }
  .loadmore::before {
    content: '$ ';
    color: var(--accent);
  }
  .loadmore:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--surface-hover);
  }
  .loadmore[hidden] {
    display: none;
  }

  /* scroll-in animation */
  .grid :global(.card) {
    opacity: 0;
    transform: translateY(8px);
    animation: rise 0.4s ease forwards;
  }
  @keyframes rise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .about {
    padding-block: clamp(2.5rem, 7vh, 4.5rem);
    border-top: 1px solid var(--border);
  }
  .about-body {
    max-width: 68ch;
  }
  .about-body p {
    margin: 0 0 1.1rem;
    color: var(--text);
    font-size: 0.92rem;
    line-height: 1.7;
  }
  .about-body p:last-child {
    margin-bottom: 0;
  }
  .about-mark,
  .about-name {
    color: var(--accent);
  }

  .footer {
    position: relative;
    overflow: hidden;
    border-top: 1px solid var(--border-strong);
    padding-block: 3rem;
    background: var(--bg);
  }
  .footer .wrap {
    position: relative;
  }
  .footer p {
    margin: 0;
    color: var(--text);
    font-size: 0.85rem;
  }
  .f-prompt {
    color: var(--accent);
  }

  .footer-scanlines {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      to bottom,
      rgba(51, 255, 102, 0.03) 0px,
      rgba(51, 255, 102, 0.03) 1px,
      transparent 1px,
      transparent 4px
    );
    -webkit-mask-image: radial-gradient(
      130% 100% at 50% 100%,
      #000 0%,
      transparent 85%
    );
    mask-image: radial-gradient(130% 100% at 50% 100%, #000 0%, transparent 85%);
    pointer-events: none;
    opacity: 0.4;
  }
</style>

<script>
  const PAGE_SIZE = 9;

  const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
  const cards = Array.from(
    document.querySelectorAll<HTMLElement>('#grid .card')
  );
  const searchInput = document.getElementById('search') as HTMLInputElement | null;
  const countEl = document.getElementById('count');
  const emptyEl = document.getElementById('empty');
  const loadMoreBtn = document.getElementById('loadmore') as HTMLButtonElement | null;

  let activeTag = 'all';
  let query = '';
  let limit = PAGE_SIZE;

  function matches(card: HTMLElement): boolean {
    const tags = (card.dataset.tags ?? '').split(' ');
    const tagOk = activeTag === 'all' || tags.includes(activeTag);
    const text = card.dataset.search ?? '';
    const searchOk = query === '' || text.includes(query);
    return tagOk && searchOk;
  }

  function render() {
    let matched = 0;
    let shown = 0;

    cards.forEach((card) => {
      if (!matches(card)) {
        card.style.display = 'none';
        return;
      }
      matched++;
      if (shown < limit) {
        const wasHidden = card.style.display === 'none';
        card.style.display = '';
        // only animate newly revealed cards
        if (wasHidden) {
          card.style.animation = 'none';
          // force reflow then restart
          void card.offsetWidth;
          card.style.animation = '';
        }
        shown++;
      } else {
        card.style.display = 'none';
      }
    });

    if (countEl) countEl.textContent = String(matched);
    if (emptyEl) emptyEl.hidden = matched !== 0;
    if (loadMoreBtn) loadMoreBtn.hidden = shown >= matched;
  }

  // --- filter chips ---
  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      chips.forEach((c) => c.setAttribute('aria-pressed', 'false'));
      chip.setAttribute('aria-pressed', 'true');
      activeTag = chip.dataset.filter ?? 'all';
      limit = PAGE_SIZE;
      render();
    });
  });

  // --- search (debounced) ---
  let debounce: number | undefined;
  searchInput?.addEventListener('input', () => {
    window.clearTimeout(debounce);
    debounce = window.setTimeout(() => {
      query = searchInput.value.trim().toLowerCase();
      limit = PAGE_SIZE;
      render();
    }, 120);
  });

  // --- load more ---
  loadMoreBtn?.addEventListener('click', () => {
    limit += PAGE_SIZE;
    render();
  });

  // initial staggered animation delays (first page only)
  cards.forEach((card, i) => {
    card.style.animationDelay = `${Math.min(i * 60, 480)}ms`;
  });

  render();

  // --- compact sticky header reveal + offset for sticky controls ---
  const sentinel = document.querySelector('.hero-sentinel');
  const stickyHeader = document.getElementById('sticky-header');
  const root = document.documentElement;

  function setStickyTop(visible: boolean) {
    const h = stickyHeader?.offsetHeight ?? 0;
    root.style.setProperty('--sticky-top', visible ? `${h}px` : '0px');
  }

  if (sentinel && stickyHeader) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        const visible = !entry.isIntersecting;
        stickyHeader.dataset.state = visible ? 'visible' : 'hidden';
        setStickyTop(visible);
      },
      { rootMargin: '0px', threshold: 0 }
    );
    observer.observe(sentinel);
  }
</script>
