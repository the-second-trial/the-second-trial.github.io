---
const { title = 'The 2nd Trial' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="The 2nd Trial — articles and projects on science, data, and the things worth a second look."
    />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <style is:global>
      :root {
        /* fonts — monospace everywhere, terminal style */
        --font-sans: ui-monospace, 'SF Mono', 'JetBrains Mono', 'Cascadia Code',
          'Fira Code', Menlo, Consolas, monospace;
        --font-display: var(--font-sans);
        --font-mono: var(--font-sans);

        /* phosphor terminal palette — mostly black, green as accent */
        --bg: #050705;
        --bg-soft: #0a0d0a;
        --surface: rgba(51, 255, 102, 0.02);
        --surface-hover: rgba(51, 255, 102, 0.05);
        --border: rgba(51, 255, 102, 0.1);
        --border-strong: rgba(51, 255, 102, 0.28);

        --text: #c3d6c8;
        --text-muted: #6f8a76;
        --text-faint: #455c4c;

        --accent: #33ff66; /* matrix green */
        --accent-2: #00ff41; /* brighter signal green */
        --accent-glow: rgba(51, 255, 102, 0.3);

        /* shape — terminal = sharp corners */
        --radius: 0px;
        --radius-sm: 0px;
        --maxw: 1080px;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        font-family: var(--font-sans);
        font-size: 15px;
        line-height: 1.6;
        color: var(--text);
        background: var(--bg);
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      a {
        color: var(--accent);
        text-decoration: none;
      }
      a:hover {
        text-decoration: underline;
        text-underline-offset: 3px;
      }

      h1,
      h2,
      h3 {
        font-family: var(--font-display);
        font-weight: 700;
        line-height: 1.2;
        letter-spacing: 0;
      }

      ::selection {
        background: var(--accent);
        color: var(--bg);
      }

      .wrap {
        max-width: var(--maxw);
        margin: 0 auto;
        padding-inline: 1.5rem;
      }

      /* blinking terminal cursor, reusable */
      .cursor::after {
        content: '_';
        margin-left: 0.1em;
        color: var(--accent);
        animation: blink 1.1s step-end infinite;
      }
      @keyframes blink {
        0%,
        50% {
          opacity: 1;
        }
        50.01%,
        100% {
          opacity: 0;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
        * {
          animation: none !important;
          transition: none !important;
        }
      }
    </style>
  </body>
</html>
